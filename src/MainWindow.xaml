<Window
    x:Class="GithubClone.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GithubClone"
    Title="Github Clone">
    
    <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20">
        <TextBlock Text="GitHub Clone" FontSize="24" FontWeight="Bold" Margin="0,0,0,20" HorizontalAlignment="Center"/>
        <TextBox x:Name="RepoUrlTextBox" PlaceholderText="Enter repository URL, e.g.: https://github.com/user/repo" Width="400" Margin="0,0,0,10"/>
        <Button x:Name="CloneButton" Content="Clone" Width="100" HorizontalAlignment="Center" Margin="0,0,0,20"/>
        <ProgressBar x:Name="CloneProgress" IsIndeterminate="False" Width="400" Visibility="Collapsed"/>
        <TextBlock x:Name="StatusText" TextWrapping="Wrap" Width="400" Margin="0,10,0,0"/>
    </StackPanel>
</Window>