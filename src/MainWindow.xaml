<Window
    x:Class="GithubClone.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center" Width="500" Padding="20">
            <TextBlock Text="GitHub 仓库克隆工具" FontSize="24" FontWeight="Bold" Margin="0,0,0,20" HorizontalAlignment="Center"/>
            
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="GitHub 用户名:" Width="120" VerticalAlignment="Center"/>
                <TextBox x:Name="UsernameTextBox" Width="200" Margin="10,0,10,0"/>
                <Button x:Name="FetchButton" Content="获取仓库" Width="100" Click="FetchButton_Click"/>
            </StackPanel>

            <TextBlock Text="仓库列表:" Margin="0,10,0,5"/>
            <ListBox x:Name="RepoListBox" Height="150" Margin="0,0,0,10"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="克隆到:" Width="120" VerticalAlignment="Center"/>
                <TextBox x:Name="PathTextBox" Width="200" Margin="10,0,10,0"/>
                <Button x:Name="BrowseButton" Content="浏览..." Width="100" Click="BrowseButton_Click"/>
            </StackPanel>

            <Button x:Name="CloneButton" Content="克隆选中仓库" HorizontalAlignment="Center" Width="150" Margin="0,10,0,10" Click="CloneButton_Click"/>

            <TextBlock x:Name="StatusTextBlock" Text="" Margin="0,10,0,0" FontStyle="Italic"/>
        </StackPanel>
    </ScrollViewer>
</Window>