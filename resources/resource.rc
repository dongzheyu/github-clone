#include <windows.h>
#include "resource.h"
#define IDR_VERSION1 1
IDI_ICON1 ICON DISCARDABLE "logo.ico"

// 数字签名证书
//////////////////////////////////////////////////////////////////////////////
//
// 数字签名
//

LANGUAGE LANG_CHINESE, SUBLANG_CHINESE_SIMPLIFIED

IDD_MAIN_DIALOG DIALOGEX 0, 0, 350, 250
CAPTION "GitHub仓库克隆工具"
FONT 9, "微软雅黑", 400
BEGIN
    LTEXT           "GitHub用户名:", -1, 10, 10, 60, 15
    EDITTEXT        IDC_USERNAME_EDIT, 75, 8, 120, 15, ES_AUTOHSCROLL
    PUSHBUTTON      "获取仓库", IDC_FETCH_BUTTON, 200, 8, 60, 15
    
    LTEXT           "仓库列表:", -1, 10, 30, 60, 15
    LISTBOX         IDC_REPO_LIST, 10, 45, 330, 120, LBS_NOTIFY | LBS_HASSTRINGS | WS_VSCROLL | WS_BORDER | LBS_OWNERDRAWFIXED | LBS_MULTIPLESEL
    
    LTEXT           "下载到:", -1, 10, 170, 60, 15
    EDITTEXT        IDC_PATH_EDIT, 75, 168, 120, 15, ES_AUTOHSCROLL
    PUSHBUTTON      "浏览...", IDC_BROWSE_BUTTON, 200, 168, 60, 15
    
    PUSHBUTTON      "克隆选中仓库", IDC_CLONE_BUTTON, 120, 195, 100, 20
    
    LTEXT           "", IDC_STATUS_LABEL, 10, 220, 330, 15
END

/////////////////////////////////////////////////////////////////////////////
//
// Version
//

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "JetCPP\0"
            VALUE "FileDescription", "GitHub Repository Clone Tool\0"
            VALUE "FileVersion", "1.0.0.0\0"
            VALUE "InternalName", "github_clone_win32\0"
            VALUE "LegalCopyright", "Copyright (C) 2025 JetCPP\0"
            VALUE "OriginalFilename", "github_clone_win32.exe\0"
            VALUE "ProductName", "GitHub仓库克隆工具\0"
            VALUE "ProductVersion", "1.0.0.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END